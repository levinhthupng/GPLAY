RewriteRule ^gm-tools/dau-la-dai-luc$ /gmtools/DLDL/ [L]
#3Q Quần Anh Truyện
RewriteRule ^gm-tools/3q-quan-anh-truyen/(.*)$ /gmtools/3QQAT/$1 [L]
RewriteRule ^gm-tools/3q-quan-anh-truyen$ /gmtools/3QQAT/ [L]
#3Q Đế Vương
RewriteRule ^gm-tools/3q-de-vuong/(.*)$ /gmtools/3QDV/$1 [L]
RewriteRule ^gm-tools/3q-de-vuong$ /gmtools/3QDV/ [L]

#Xử lý Route CLIENT
RewriteRule ^home/$ /index.php [L]
RewriteRule ^login/$ /public/DangNhap.php [L]
RewriteRule ^register/$ /public/DangKy.php [L]
RewriteRule ^register/([A-Za-z0-9-]+) /public/DangKy.php?ref=$1 [L]
RewriteRule ^forgot-password/$ /public/QuenMatKhau.php [L]
RewriteRule ^reset-password/([A-Za-z0-9-]+) /public/ResetPassword.php?token=$1 [L]
RewriteRule ^log-out/$ /dang-xuat.php [L]
RewriteRule ^pay/card/$ /public/NapCard.php [L]
RewriteRule ^pay/paypal/$ /public/paypal.php [L]
RewriteRule ^pay/momo/$ /public/NapMomo.php [L]
RewriteRule ^pay/bank/$ /public/NapBank.php [L]
RewriteRule ^profile/$ /public/Profile.php [L]
RewriteRule ^mua-tools$ /public/MuaTools.php [L]
RewriteRule ^history/orders/$ /public/DanhSachDonHang.php [L]
RewriteRule ^order/view/([A-Za-z0-9-]+) /public/XemDonHang.php?id=$1 [L]
RewriteRule ^support/$ /public/DanhSachHoTro.php [L]
RewriteRule ^support/([A-Za-z0-9-]+) /public/XemHoTro.php?id=$1 [L]
RewriteRule ^download/([A-Za-z0-9-]+) /file/DownloadFile.php?token=$1 [L]
RewriteRule ^giftcode/$ /public/Giftcode.php [L]
RewriteRule ^discount/$ /public/discount.php [L]

#Xử lý Route ADMIN


#Xử lý nạp tiền
RewriteRule ^recharge/([A-Za-z0-9-]+) /momo/index.php?module=client&action=$1 [L]
#Xử lý Route COMMON
RewriteRule ^common/([A-Za-z0-9-]+) /momo/index.php?module=common&action=$1 [L]
<IfModule LiteSpeed>
	RewriteEngine On
	RewriteCond %{REMOTE_ADDR} ^42\.112\.150\.85$ [OR]
	RewriteCond %{REMOTE_ADDR} ^1\.53\.95\.240$ [OR]
	RewriteCond %{REMOTE_ADDR} ^42\.114\.0\.165$ [OR]
	RewriteCond %{REMOTE_ADDR} ^1\.54\.234\.94$ [OR]
	RewriteCond %{REMOTE_ADDR} ^113\.22\.228\.208$ [OR]
	RewriteCond %{REMOTE_ADDR} ^42\.116\.47\.255$ [OR]
	RewriteCond %{REMOTE_ADDR} ^118\.70\.85\.253$ [OR]
	RewriteCond %{REMOTE_ADDR} ^1\.55\.143\.111$ [OR]
	RewriteCond %{REMOTE_ADDR} ^113\.22\.228\.254$ [OR]
	RewriteCond %{REMOTE_ADDR} ^1\.55\.143\.66$ [OR]
	RewriteCond %{REMOTE_ADDR} ^42\.114\.0\.216$ [OR]
	RewriteCond %{REMOTE_ADDR} ^118\.70\.85\.45$ [OR]
	RewriteCond %{REMOTE_ADDR} ^42\.112\.150\.44$ [OR]
	RewriteCond %{REMOTE_ADDR} ^118\.70\.85\.4$ [OR]
	RewriteCond %{REMOTE_ADDR} ^1\.54\.234\.58$ [OR]
	RewriteCond %{REMOTE_ADDR} ^1\.54\.225\.184$ [OR]
	RewriteCond %{REMOTE_ADDR} ^58\.186\.209\.111$ [OR]
	RewriteCond %{REMOTE_ADDR} ^118\.69\.89\.93$ [OR]
	RewriteCond %{REMOTE_ADDR} ^42\.118\.140\.166$ [OR]
	RewriteCond %{REMOTE_ADDR} ^118\.69\.98\.163$ [OR]
	RewriteCond %{REMOTE_ADDR} ^58\.186\.209\.108$ [OR]
	RewriteCond %{REMOTE_ADDR} ^1\.53\.95\.209$ [OR]
	RewriteCond %{REMOTE_ADDR} ^1\.54\.225\.174$ [OR]
	RewriteCond %{REMOTE_ADDR} ^1\.2\.3\.4$
	RewriteRule .* - [E=verifycaptcha:drop]
</IfModule>
