RewriteRule ^gm-tools/dai-hiep-chay-di/(.*)$ /gmtools/DHCD/$1 [L]
RewriteRule ^gm-tools/dai-hiep-chay-di$ /gmtools/DHCD/ [L]
#Tiên Kiếm Vấn Đạo
