RewriteRule ^gm-tools/hang-long-thap-bat-chuong$ /gmtools/HLTBC/ [L]
#Rồng Thần
RewriteRule ^gm-tools/rong-than/(.*)$ /gmtools/RONGTHAN/$1 [L]
RewriteRule ^gm-tools/rong-than$ /gmtools/RONGTHAN/ [L]
#Cửu Châu H5
RewriteRule ^gm-tools/cuu-chau-h5/(.*)$ /gmtools/CUUCHAUH5/$1 [L]
RewriteRule ^gm-tools/cuu-chau-h5$ /gmtools/CUUCHAUH5/ [L]
#The God H5
RewriteRule ^gm-tools/the-god-h5/(.*)$ /gmtools/TGH5/$1 [L]
RewriteRule ^gm-tools/the-god-h5$ /gmtools/TGH5/ [L]
#Thiên Địa Quyết
RewriteRule ^gm-tools/thien-dia-quyet/(.*)$ /gmtools/TDQ/$1 [L]
RewriteRule ^gm-tools/thien-dia-quyet$ /gmtools/TDQ/ [L]
#Bách Chiến Truyền Kỳ
