RewriteRule ^gm-tools/mu-h5/(.*)$ /gmtools/MUH5/$1 [L]
RewriteRule ^gm-tools/mu-h5$ /gmtools/MUH5/ [L]
#Ma Hoang Ky H5
RewriteRule ^gm-tools/man-hoang-ky-h5/(.*)$ /gmtools/MHK/$1 [L]
RewriteRule ^gm-tools/man-hoang-ky-h5$ /gmtools/MHK/ [L]
#Bộ Lạc H5
